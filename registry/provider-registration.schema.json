{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://udlm.dev/registry/udlm/0.1/provider-registration.schema.json",
  "title": "Provider registration",
  "description": "What a provider submits to register with a control plane (provider-contract.md §2 and §7). It is a set of claims and evidence. The control plane checks them and writes its own record, the registration verdict. Trust, admitted capabilities and lifecycle state live there, never here.",
  "examples": [
    {
      "record_type": "provider_registration",
      "uuid": "3f8b1d40-72c6-4a19-9e05-8d24b1706fa3",
      "conforms_to": "udlm/0.1",
      "handle": "lab/storage/zfs-host-a",
      "version": "1.1.0",
      "display_name": "ZFS host A",
      "description": "Realizes ZFS volumes and storage pools on one lab host, and reports the network it sits on.",
      "capabilities": [
        "realize_resources/Storage",
        "realize_resources/Machine",
        "serve_data/Network"
      ],
      "capability_profiles": {
        "realize_resources": {
          "resource_types": [
            {
              "fqn": "StoragePool",
              "version": "0.7.2"
            },
            {
              "fqn": "Volume.ZFS",
              "version": "0.8.3"
            }
          ],
          "two_phase_realization": {
            "hold_supported": true,
            "min_hold_ttl": "PT30S",
            "max_hold_ttl": "PT30M"
          },
          "cancellation": {
            "supported": true,
            "during": [
              "dispatched",
              "provisioning"
            ]
          },
          "discovery": {
            "supported": true,
            "method": "api_query"
          },
          "dependency_introspection": {
            "supported": true,
            "methods": [
              "api_query",
              "inferred_from_config"
            ],
            "response_sla": "PT30S",
            "max_edges_per_response": 500
          }
        },
        "serve_data": {
          "data_domains": [
            {
              "domain": "network",
              "data_types": [
                "vlan",
                "address_assignment"
              ]
            }
          ],
          "data_freshness_sla": "PT15M",
          "write_back_supported": false
        }
      },
      "sovereignty_declaration": {
        "operating_jurisdictions": [
          "US"
        ],
        "data_residency_zones": [
          "US-MN"
        ],
        "enforcement_plane": "both",
        "sub_processors": [],
        "data_residency_guarantee": true,
        "legal_frameworks": [],
        "external_dependencies": {
          "air_gap_capable": true,
          "external_services": []
        },
        "audit_rights": {
          "customer_audit_right": true,
          "audit_notice_days": 14,
          "third_party_audit_accepted": true
        },
        "change_notification": {
          "notification_endpoint": "https://zfs-host-a.lab.example/notify",
          "mandatory_notification_events": [
            "jurisdiction_change",
            "sub_processor_change"
          ],
          "notification_sla": "P2D"
        }
      },
      "conformance_claims": [
        {
          "framework": "iso_27001",
          "statement": "Self-assessed; no certificate yet."
        }
      ],
      "accreditations": [
        {
          "accreditation_uuid": "7a2e4c19-5b83-4f06-a1d7-3c9e8b20f415",
          "framework": "iso_27001"
        }
      ],
      "accepts_roles": [
        "execution"
      ],
      "requests_data": [
        {
          "path": "placement.location_ref",
          "reason": "Places the pool on the disk shelf the estate chose; the provider cannot derive it."
        }
      ],
      "health_endpoint": "https://zfs-host-a.lab.example/health",
      "certificate": {
        "pem": "-----BEGIN CERTIFICATE-----\n(provider leaf certificate)\n-----END CERTIFICATE-----\n",
        "ca_chain": "-----BEGIN CERTIFICATE-----\n(lab intermediate CA)\n-----END CERTIFICATE-----\n",
        "rotation_interval": "P90D"
      },
      "network_reachability": {
        "egress": [
          {
            "host": "zfs-host-a.lab.example",
            "port": 443,
            "protocol": "https"
          }
        ],
        "ingress": [
          {
            "endpoint": "lifecycle"
          },
          {
            "endpoint": "telemetry"
          }
        ]
      },
      "telemetry": {
        "metrics": {
          "supported": true,
          "exposition": [
            "prometheus"
          ],
          "endpoint": "https://zfs-host-a.lab.example/metrics"
        },
        "logs": {
          "supported": true,
          "transport": [
            "syslog"
          ],
          "endpoint": "https://zfs-host-a.lab.example/log-config"
        },
        "events": {
          "supported": true
        },
        "per_resource_scoping": true,
        "per_tenant_scoping": true,
        "unavailable_for": [
          "StorageDevice"
        ]
      }
    }
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "uuid",
    "conforms_to",
    "handle",
    "version",
    "capabilities",
    "sovereignty_declaration",
    "accepts_roles",
    "health_endpoint",
    "certificate"
  ],
  "properties": {
    "record_type": {
      "const": "provider_registration"
    },
    "uuid": {
      "$ref": "common-elements.schema.json#/$defs/uuid_v4",
      "description": "The provider's identity. A registration verdict names it as `provider_uuid`."
    },
    "conforms_to": {
      "type": "string",
      "pattern": "^udlm/[0-9]+\\.[0-9]+$"
    },
    "handle": {
      "$ref": "common-elements.schema.json#/$defs/handle"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "The version of this registration. A changed registration is a new version."
    },
    "display_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      },
      "description": "The declared capability set (ADR-PROV-002). Each entry is a verb, or a verb and domain, from provider-capability.yaml. Declaring grants nothing: every entry starts pending in the verdict (ADR-PROV-003)."
    },
    "capability_profiles": {
      "$ref": "#/$defs/capability_profiles"
    },
    "sovereignty_declaration": {
      "$ref": "#/$defs/sovereignty_declaration"
    },
    "conformance_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "framework"
        ],
        "properties": {
          "framework": {
            "type": "string",
            "description": "A framework the provider claims to meet, such as iso_27001 or soc2_type2."
          },
          "level": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          }
        }
      },
      "description": "Standards the provider claims to meet. Each is self-asserted until an accreditation attests it (accreditation matrix §3.7)."
    },
    "accreditations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accreditation_uuid"
        ],
        "properties": {
          "accreditation_uuid": {
            "$ref": "common-elements.schema.json#/$defs/uuid_v4"
          },
          "framework": {
            "type": "string",
            "description": "A readability hint. The control plane reads the framework from the accreditation record."
          }
        }
      },
      "description": "References to registered accreditation records. Status and expiry are not restated; the control plane reads them from the record."
    },
    "accepts_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common-elements.schema.json#/$defs/data_role"
      },
      "description": "The data roles this provider accepts (data-roles.md). It only narrows: dispatch still sends nothing beyond the bound class and recorded grants (DSP-001 to DSP-003)."
    },
    "requests_data": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "The element the provider asks for, as a dotted path."
          },
          "reason": {
            "type": "string",
            "description": "Why the provider needs it and cannot derive it."
          }
        }
      },
      "description": "Data the provider needs beyond its class (PRV-013). Policy grants, narrows or refuses each request. A grant is recorded on the requested record."
    },
    "needs_from_implementation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain"
        ],
        "properties": {
          "domain": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "description": "What the provider needs from the implementation, matched at registration (§10.2). The provider opts in to each match; nothing is subscribed automatically (DISC-004)."
    },
    "health_endpoint": {
      "type": "string",
      "format": "uri"
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pem",
        "ca_chain"
      ],
      "properties": {
        "pem": {
          "type": "string",
          "description": "The provider's mTLS leaf certificate, PEM encoded."
        },
        "ca_chain": {
          "type": "string",
          "description": "The issuing chain the control plane pins for this provider, PEM encoded."
        },
        "rotation_interval": {
          "type": "string",
          "pattern": "^P(?!$)([0-9]+Y)?([0-9]+M)?([0-9]+W)?([0-9]+D)?(T(?=[0-9])([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$",
          "description": "The oldest certificate the control plane accepts, as an ISO 8601 duration. An older certificate is flagged at health check."
        }
      },
      "description": "The provider's zero-trust identity. This is evidence: the control plane verifies it and computes the trust posture in the verdict."
    },
    "network_reachability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "egress": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host",
              "port"
            ],
            "properties": {
              "host": {
                "type": "string"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "protocol": {
                "type": "string"
              }
            }
          },
          "description": "Destinations the control plane must be able to reach."
        },
        "ingress": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "endpoint"
            ],
            "properties": {
              "endpoint": {
                "enum": [
                  "lifecycle",
                  "telemetry"
                ],
                "description": "The control-plane endpoint the provider calls back: lifecycle events (§6) or telemetry (§7)."
              }
            }
          },
          "description": "Callbacks the provider makes to the control plane."
        }
      },
      "description": "Declared network reachability. The platform provisions connectivity from it, so onboarding a provider needs no hand-edited firewall rule."
    },
    "telemetry": {
      "$ref": "#/$defs/telemetry"
    }
  },
  "$defs": {
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z_]*(/[A-Z][A-Za-z0-9.]*)?$",
      "description": "A provider-capability term: a verb, or a verb and a resource domain such as realize_resources/Storage. validate.py checks it names a term in provider-capability.yaml."
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$",
      "description": "An ISO 3166-1 alpha-2 country code, or an ISO 3166-2 subdivision such as US-MN."
    },
    "sovereignty_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operating_jurisdictions",
        "data_residency_zones",
        "enforcement_plane"
      ],
      "properties": {
        "operating_jurisdictions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/jurisdiction"
          },
          "description": "The sovereignty regimes the provider operates under, matched exactly (accreditation matrix §3.8)."
        },
        "data_residency_zones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/jurisdiction"
          },
          "description": "Where data may reside. Residency subsumes down the hierarchy: US covers US-MN."
        },
        "enforcement_plane": {
          "enum": [
            "data",
            "control",
            "both"
          ],
          "description": "Which plane this claim covers (§3.8). A data-plane requirement is met only by a data or both claim."
        },
        "sub_processors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "jurisdiction"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "jurisdiction": {
                "$ref": "#/$defs/jurisdiction"
              },
              "data_handled": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "description": "Third parties with access to data. An empty list says there are none."
        },
        "data_residency_guarantee": {
          "type": "boolean",
          "description": "True if data never leaves the declared zones."
        },
        "legal_frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Legal frameworks the provider meets, such as eu_gdpr."
        },
        "excluded_frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Frameworks the provider says it cannot meet."
        },
        "jurisdiction_detail": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "country"
            ],
            "properties": {
              "country": {
                "$ref": "#/$defs/jurisdiction"
              },
              "legal_system": {
                "type": "string"
              },
              "data_center_location": {
                "type": "string"
              }
            }
          }
        },
        "external_dependencies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "air_gap_capable": {
              "type": "boolean"
            },
            "opt_out_available": {
              "type": "boolean"
            },
            "external_services": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "service"
                ],
                "properties": {
                  "service": {
                    "type": "string"
                  },
                  "jurisdiction": {
                    "$ref": "#/$defs/jurisdiction"
                  },
                  "data_shared": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "government_access_risk": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jurisdictions_with_compelled_access": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/jurisdiction"
              }
            },
            "legal_challenge_policy": {
              "type": "string"
            }
          },
          "description": "Exposure to compelled government access, such as the US CLOUD Act."
        },
        "audit_rights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "customer_audit_right": {
              "type": "boolean"
            },
            "audit_notice_days": {
              "type": "integer",
              "minimum": 0
            },
            "third_party_audit_accepted": {
              "type": "boolean"
            }
          }
        },
        "change_notification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "notification_endpoint"
          ],
          "properties": {
            "notification_endpoint": {
              "type": "string",
              "format": "uri"
            },
            "mandatory_notification_events": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notification_sla": {
              "type": "string",
              "description": "How soon a change is notified, as an ISO 8601 duration."
            }
          },
          "description": "Where and how fast the provider notifies a change to anything it declared here."
        }
      },
      "description": "The provider-wide sovereignty claim. A claim is self-asserted until an accreditation attests exactly its scope. A capability may override it for its own category; the finest grain wins (accreditation matrix §3.3.1)."
    },
    "signal": {
      "type": "object",
      "required": [
        "supported"
      ],
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "description": "Where the control plane collects or configures delivery of this signal."
        }
      },
      "description": "The part every telemetry signal shares. Each signal closes its own object."
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metrics",
        "logs",
        "events",
        "per_resource_scoping",
        "per_tenant_scoping"
      ],
      "properties": {
        "metrics": {
          "allOf": [
            {
              "$ref": "#/$defs/signal"
            }
          ],
          "properties": {
            "supported": true,
            "endpoint": true,
            "exposition": {
              "type": "array",
              "items": {
                "enum": [
                  "prometheus",
                  "openmetrics"
                ]
              },
              "description": "Standard exposition formats only."
            }
          },
          "unevaluatedProperties": false
        },
        "logs": {
          "allOf": [
            {
              "$ref": "#/$defs/signal"
            }
          ],
          "properties": {
            "supported": true,
            "endpoint": true,
            "transport": {
              "type": "array",
              "items": {
                "enum": [
                  "syslog",
                  "otlp",
                  "http_push"
                ]
              }
            }
          },
          "unevaluatedProperties": false
        },
        "events": {
          "allOf": [
            {
              "$ref": "#/$defs/signal"
            }
          ],
          "properties": {
            "supported": true,
            "endpoint": true
          },
          "unevaluatedProperties": false,
          "description": "Lifecycle events (§6) are the minimum. A richer stream is declared here."
        },
        "per_resource_scoping": {
          "type": "boolean",
          "description": "True if signals carry the entity uuid or handle, so collection is attributable per resource."
        },
        "per_tenant_scoping": {
          "type": "boolean",
          "description": "True if signals carry the tenant, so collection and what is built on it isolate per tenant."
        },
        "unavailable_for": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Classes the provider cannot emit telemetry for. The control plane records telemetry_unavailable on their entities."
        }
      },
      "description": "The telemetry descriptor (§7). The control plane reads it to learn which signals exist and where to configure delivery. It does not probe or guess."
    },
    "duration": {
      "type": "string",
      "pattern": "^P(?!$)([0-9]+Y)?([0-9]+M)?([0-9]+W)?([0-9]+D)?(T(?=[0-9])([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$",
      "description": "An ISO 8601 duration."
    },
    "class_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fqn",
        "version"
      ],
      "properties": {
        "fqn": {
          "type": "string",
          "description": "The class the provider binds to: a Base, a Type, or a Provider Class where the offering carries provider-specific data (CLS-005)."
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "description": "A projection of a class the provider binds to. The class is authored; this entry is rendered from it (ADR-038 addendum)."
    },
    "realize_resources_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_types",
        "two_phase_realization"
      ],
      "properties": {
        "resource_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/class_binding"
          },
          "description": "The classes this provider realizes. Binding at a tier accepts orders at every tier above it (CLS-002 (c))."
        },
        "two_phase_realization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hold_supported"
          ],
          "properties": {
            "hold_supported": {
              "type": "boolean",
              "description": "False means reserve only validates and returns facts; it holds nothing."
            },
            "min_hold_ttl": {
              "$ref": "#/$defs/duration"
            },
            "max_hold_ttl": {
              "$ref": "#/$defs/duration"
            }
          },
          "description": "Reserve, commit and release (§6a), a base obligation of this capability. A requested hold is clamped to the declared range."
        },
        "cancellation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported"
          ],
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "during": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The states in which a cancellation is accepted."
            },
            "endpoint": {
              "type": "string",
              "description": "Where the control plane sends a cancellation."
            },
            "response_time": {
              "$ref": "#/$defs/duration",
              "description": "How soon the provider answers a cancellation."
            },
            "partial_rollback_possible": {
              "type": "boolean",
              "description": "True if a cancellation can leave partial resources, so it may end in CANCELLATION_FAILED."
            }
          },
          "description": "Cancellation support (operational-models.md §3.2)."
        },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported"
          ],
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "method": {
              "enum": [
                "api_query",
                "passive_event",
                "hybrid"
              ]
            },
            "endpoint": {
              "type": "string",
              "description": "Where the control plane asks for discovered state."
            },
            "max_entities_per_batch": {
              "type": "integer",
              "minimum": 1
            },
            "latency_p95": {
              "$ref": "#/$defs/duration",
              "description": "How long discovery typically takes, at the 95th percentile."
            },
            "supports_incremental": {
              "type": "boolean",
              "description": "True if the provider can return only entities changed since the last discovery."
            }
          },
          "description": "Discovery support (operational-models.md §4)."
        },
        "dependency_introspection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported"
          ],
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "methods": {
              "type": "array",
              "items": {
                "enum": [
                  "api_query",
                  "passive_event",
                  "inferred_from_config"
                ]
              }
            },
            "response_sla": {
              "$ref": "#/$defs/duration",
              "description": "No longer than the discovery endpoint's SLA (OBS-004)."
            },
            "max_edges_per_response": {
              "type": "integer",
              "minimum": 1
            }
          },
          "description": "Observed dependency edges for an entity the provider hosts (service-dependencies.md §3a). Observational only; never consulted for orchestration."
        },
        "naturalization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target_format": {
              "type": "string",
              "description": "The native format the provider translates to, such as a hypervisor API. A free string: the spec names no product."
            }
          }
        },
        "instance_size_catalog": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "class",
              "resources"
            ],
            "properties": {
              "class": {
                "type": "string",
                "description": "A size class from the portable vocabulary (ADR-014)."
              },
              "resources": {
                "type": "object",
                "description": "What the class resolves to on this provider, in the class's raw resource fields."
              }
            }
          },
          "description": "The provider's size classes and what each resolves to. Declared, not queried live, so placement can compare many providers at once (§8.1a)."
        },
        "version_channels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "engine",
              "channel",
              "resolves_to"
            ],
            "properties": {
              "engine": {
                "type": "string"
              },
              "channel": {
                "type": "string",
                "description": "An abstract version, such as latest or lts."
              },
              "resolves_to": {
                "type": "string",
                "description": "The concrete version the channel means on this provider now."
              },
              "supported": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "description": "How the provider resolves an abstract version to a concrete one. The realized record carries the concrete value, for audit (§8.1a)."
        }
      },
      "description": "The realize_resources profile (§8.1)."
    },
    "serve_data_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_domains"
      ],
      "properties": {
        "data_domains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "domain"
            ],
            "properties": {
              "domain": {
                "type": "string"
              },
              "data_types": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "description": "What data the provider serves. Its authority level is not declared here; the control plane assigns it."
        },
        "max_queries_per_second": {
          "type": "integer",
          "minimum": 1
        },
        "data_freshness_sla": {
          "$ref": "#/$defs/duration"
        },
        "write_back_supported": {
          "type": "boolean"
        }
      },
      "description": "The serve_data profile (§8.2)."
    },
    "composite_service_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution": {
          "enum": [
            "dependency_ordered"
          ]
        },
        "max_concurrent_implementations": {
          "type": "integer",
          "minimum": 1
        },
        "max_constituent_count": {
          "type": "integer",
          "minimum": 1
        },
        "max_nesting_depth": {
          "type": "integer",
          "minimum": 1
        },
        "partial_delivery_supported": {
          "type": "boolean"
        },
        "compensation_supported": {
          "type": "boolean"
        }
      },
      "description": "The limits a provider declares for composite services it fulfils (§8.3). The composite itself is a class with constituents; its shape is not restated here."
    },
    "authenticate_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authentication_modes"
      ],
      "properties": {
        "authentication_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "oidc",
              "ldap",
              "saml",
              "mtls",
              "hardware_token"
            ]
          }
        },
        "mfa_methods": {
          "type": "array",
          "items": {
            "enum": [
              "totp",
              "push_notification",
              "hardware_token"
            ]
          }
        },
        "rbac_model": {
          "enum": [
            "flat",
            "hierarchical",
            "abac"
          ]
        },
        "step_up_supported": {
          "type": "boolean"
        },
        "token_lifetime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default": {
              "$ref": "#/$defs/duration"
            },
            "max": {
              "$ref": "#/$defs/duration"
            }
          }
        },
        "federation_capable": {
          "type": "boolean"
        },
        "supports_session_revocation": {
          "type": "boolean"
        }
      },
      "description": "The authenticate profile (§8.4). Authentication is a capability any provider may declare, not a provider type."
    },
    "federate_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tunnel_type"
      ],
      "properties": {
        "tunnel_type": {
          "enum": [
            "peer",
            "parent_child",
            "hub_spoke"
          ]
        },
        "inbound_authorization": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation"
            ],
            "properties": {
              "operation": {
                "type": "string"
              },
              "resource_types": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "description": "What this peer asks to be allowed to request. Advisory: the local side of the tunnel sets the real scope."
        },
        "outbound_authorization": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation"
            ],
            "properties": {
              "operation": {
                "type": "string"
              },
              "resource_types": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "description": "What this peer intends to request of others. Advisory, like inbound."
        },
        "max_classification": {
          "type": "string",
          "description": "The most sensitive data the peer channel may carry."
        }
      },
      "description": "The federate profile (§8.5): another control plane joining as a peer. Its accreditations are in the registration's accreditations list, and the verdict computes its trust."
    },
    "execute_workflows_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported_definitions"
      ],
      "properties": {
        "supported_definitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "The Process-family classes the provider binds to, rendered from the classes (CLS-005)."
        },
        "max_concurrent_executions": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_default": {
          "$ref": "#/$defs/duration"
        },
        "idempotent": {
          "type": "boolean"
        },
        "cancellation_supported": {
          "type": "boolean"
        },
        "engine": {
          "type": "string",
          "description": "The workflow engine behind the provider. A free string: the spec names no product."
        }
      },
      "description": "The execute_workflows profile (§8.6)."
    },
    "capability_profiles": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "realize_resources": {
          "$ref": "#/$defs/realize_resources_profile"
        },
        "serve_data": {
          "$ref": "#/$defs/serve_data_profile"
        },
        "composite_service": {
          "$ref": "#/$defs/composite_service_profile"
        },
        "authenticate": {
          "$ref": "#/$defs/authenticate_profile"
        },
        "federate": {
          "$ref": "#/$defs/federate_profile"
        },
        "execute_workflows": {
          "$ref": "#/$defs/execute_workflows_profile"
        }
      },
      "description": "The detail behind declared capabilities, one profile per verb (§8). A profile needs its verb among the declared capabilities; validate.py checks it. composite_service needs realize_resources."
    },
    "resource_advertisement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/capability"
        },
        "inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resource_ref",
              "resource_type"
            ],
            "properties": {
              "resource_ref": {
                "type": "string"
              },
              "resource_type": {
                "type": "string"
              },
              "selectable": {
                "type": "boolean"
              }
            }
          }
        },
        "capacity": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resource_ref",
              "dimensions"
            ],
            "properties": {
              "resource_ref": {
                "type": "string"
              },
              "dimensions": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "total": {},
                    "free": {}
                  }
                }
              }
            }
          }
        },
        "eligibility": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resource_ref"
            ],
            "properties": {
              "resource_ref": {
                "type": "string"
              },
              "zone": {
                "type": "string"
              },
              "requires_capability": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "description": "What a provider offers, how much is free and its declared constraints (§8.1a). Returned by the capabilities endpoint, not part of the registration. Availability is authoritative; eligibility is policy."
    },
    "matched_capabilities_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matched_capabilities",
        "unmatched_needs"
      ],
      "properties": {
        "matched_capabilities": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "streams",
              "subscribe_endpoint",
              "auto_subscribed"
            ],
            "properties": {
              "streams": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "subscribe_endpoint": {
                "type": "string"
              },
              "auto_subscribed": {
                "const": false,
                "description": "Always false: the provider opts in (DISC-004)."
              },
              "action_required": {
                "type": "string"
              }
            }
          }
        },
        "unmatched_needs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "The implementation's answer to a registration's needs (§10.2a). It is the implementation's message, not the provider's."
    },
    "capability_registry_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "tier",
        "default_approval_method"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/capability"
        },
        "tier": {
          "enum": [
            "core",
            "verified_community",
            "organization"
          ]
        },
        "default_approval_method": {
          "enum": [
            "auto",
            "reviewed",
            "verified",
            "authorized"
          ]
        },
        "enabled_in_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The profiles that accept registrations for this category."
        }
      },
      "description": "A deployment's entry for one capability category it accepts (§9). The verb and domain are the two halves of the category, so they are not stored apart."
    }
  }
}
