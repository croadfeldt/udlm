{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://udlm.dev/registry/udlm/0.1/state-record.schema.json",
  "title": "UDLM state record — one record per lifecycle state",
  "description": "Ruling 071 (four-states.md §2.7). An entity's four states are four records — intent, requested, realized, discovered — each written by exactly one party, each immutable, each carrying one envelope plus one body. The envelope: entity_uuid (the identity every edge points at; never changes), record_uuid (this record, time-ordered), state, generation, supersedes, the tenant, the class pin, when and by which clock. The bodies: intent carries the fields as written and actor provenance; requested carries the fields after assembly and policy, the layers applied and left unapplied, the policies evaluated with their decisions, the fulfillment status when the request is refused or blocked, and the intent it came from; realized carries the fields as built, the outputs other things bind to, which provider instance built it, health, placement, the natural keys discovery recognizes it by, and the requested record it realizes; discovered carries what a sweep saw and how it was matched. One closed schema for the four kinds, dispatched on record_type; per-state rules say which body fields belong. The merged 'entity as it flows through the four states' shape (realized-entity.schema.json) is a READ MODEL assembled from these records, never written; the big blocks are shared with it by $ref so the two can never disagree about a shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "state",
    "entity_uuid",
    "record_uuid",
    "tenant_uuid",
    "conforms_to",
    "resource_type",
    "type_version",
    "at",
    "time_source",
    "fields"
  ],
  "properties": {
    "record_type": {
      "enum": [
        "intent_record",
        "requested_record",
        "realized_record",
        "discovered_record"
      ],
      "description": "Dispatch key; MUST agree with `state` (intent_record ⇔ Intent, …)."
    },
    "state": {
      "$ref": "common-elements.schema.json#/$defs/four_state",
      "description": "Which of the four states this record is. One record, one state, one author. Capitalized as the four-state vocabulary is; `record_type` is its lowercase dispatch key."
    },
    "entity_uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "The thing this record is about. Stable for the entity's life (RFC 9562 v4, minted at intent); the universal linking key (four-states.md §3); what every dependency edge targets."
    },
    "record_uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "This record (RFC 9562 v7 — time-ordered, so a state's stream sorts by identity). A new version of a state is a NEW record_uuid naming its predecessor in `supersedes`; records are never edited (ADR-051)."
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "description": "The request cycle this record belongs to. Increments on each new intent; a realized record carries the generation it realized (the observedGeneration reading)."
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "description": "The record_uuid(s) this record replaces within the same state's stream. Absent or empty on the first record of a state — the supersession chain four-states.md §2.3 asks for."
    },
    "tenant_uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "REQUIRED owning Tenant, as on realized-entity.schema.json."
    },
    "conforms_to": {
      "type": "string",
      "pattern": "^udlm/[0-9]+\\.[0-9]+$"
    },
    "resource_type": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]+(\\.[A-Z][A-Za-z0-9]+){0,2}$",
      "description": "The class the entity is an instance of — the canonical name, never a short_name (CLS-007)."
    },
    "type_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "The class version this record was authored or realized against (ADR-051 pin, human half)."
    },
    "type_digest": {
      "type": "string",
      "description": "OPTIONAL exact half of the pin (type@sha256:<hex>)."
    },
    "type_ref": {
      "type": "string",
      "description": "The `$id` of the pinned class or served spec."
    },
    "handle": {
      "$ref": "realized-entity.schema.json#/properties/handle",
      "description": "ADVISORY human-readable identity of the ENTITY (identifier-scheme §3), in the wire grammar (WIR-003); the uuid is authoritative."
    },
    "at": {
      "$ref": "realized-entity.schema.json#/$defs/realized_snapshot/properties/at",
      "description": "When this record was written, RFC 3339 normalized to UTC 'Z' (WIR-007); the clock is named by time_source."
    },
    "time_source": {
      "type": "string",
      "description": "Which clock stamped `at` (dcm-api, provider-callback, discovery-sweep, …)."
    },
    "origin": {
      "enum": [
        "declared",
        "discovered-derived",
        "backfilled"
      ],
      "description": "How this record came to exist: declared by its author; derived from a discovery (brownfield adoption); backfilled after the fact."
    },
    "metadata": {
      "$ref": "realized-entity.schema.json#/properties/metadata"
    },
    "integrity": {
      "$ref": "realized-entity.schema.json#/properties/integrity"
    },
    "audit": {
      "$ref": "realized-entity.schema.json#/properties/audit"
    },
    "fields": {
      "type": "object",
      "description": "The entity's fields, typed by its class (the flat spec compiled from it). Values are not re-validated here."
    },
    "outputs": {
      "type": "object",
      "description": "The typed outputs the class declares — its binding surface (data-model-core [D8.3]). Realized and discovered only."
    },
    "provenance": {
      "$ref": "realized-entity.schema.json#/properties/provenance"
    },
    "roles": {
      "$ref": "realized-entity.schema.json#/$defs/realized_snapshot/properties/roles"
    },
    "intent_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Requested only: the record_uuid of the intent record this was assembled from."
    },
    "requested_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Realized only: the record_uuid of the requested record this realizes — every realized record is traceable to exactly one (four-states.md §2.3)."
    },
    "assembly": {
      "$ref": "realized-entity.schema.json#/$defs/state_snapshot/properties/assembly"
    },
    "provider_preference": {
      "$ref": "realized-entity.schema.json#/properties/provider_preference"
    },
    "provider": {
      "$ref": "common-elements.schema.json#/$defs/Reference",
      "description": "Realized only: the provider INSTANCE that built it — a resolvable reference (handle or uuid), not free text. The merged schema carried only a string here, and nothing recorded which offering actually answered."
    },
    "dependencies": {
      "$ref": "realized-entity.schema.json#/properties/dependencies"
    },
    "status": {
      "$ref": "realized-entity.schema.json#/properties/status"
    },
    "sovereignty": {
      "$ref": "realized-entity.schema.json#/properties/sovereignty"
    },
    "correlation_ids": {
      "$ref": "realized-entity.schema.json#/properties/correlation_ids"
    },
    "adopted_standards": {
      "$ref": "realized-entity.schema.json#/properties/adopted_standards"
    },
    "portability": {
      "$ref": "realized-entity.schema.json#/properties/portability"
    },
    "expected_observation": {
      "$ref": "realized-entity.schema.json#/properties/expected_observation"
    },
    "process": {
      "$ref": "realized-entity.schema.json#/properties/process"
    },
    "priced_by": {
      "$ref": "realized-entity.schema.json#/properties/priced_by"
    },
    "constituents": {
      "$ref": "realized-entity.schema.json#/properties/constituents"
    },
    "matched_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Discovered only: which correlation-id schemes matched this observation to `entity_uuid` (dcm ADR-017 Decision C). Empty on an unclaimed observation."
    },
    "policies": {
      "type": "array",
      "description": "Requested only: the policies evaluated for this request cycle and what each decided — the statement of what ran, beside the per-field provenance that says what each changed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy",
          "decision"
        ],
        "properties": {
          "policy": {
            "$ref": "common-elements.schema.json#/$defs/Reference",
            "description": "The policy record, by handle or uuid."
          },
          "version": {
            "type": "string"
          },
          "policy_type": {
            "$ref": "policy.schema.json#/properties/policy_type"
          },
          "decision": {
            "$ref": "common-elements.schema.json#/$defs/policy_decision"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "dot-paths the policy set, narrowed or stripped, if any."
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "Intent"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "record_type": {
            "const": "intent_record"
          },
          "outputs": false,
          "intent_ref": false,
          "requested_ref": false,
          "assembly": false,
          "provider": false,
          "status": false,
          "sovereignty": false,
          "correlation_ids": false,
          "adopted_standards": false,
          "portability": false,
          "expected_observation": false,
          "matched_by": false,
          "dependencies": false,
          "constituents": false,
          "policies": false
        },
        "required": [
          "fields"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "Requested"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "record_type": {
            "const": "requested_record"
          },
          "outputs": false,
          "requested_ref": false,
          "provider": false,
          "sovereignty": false,
          "correlation_ids": false,
          "adopted_standards": false,
          "portability": false,
          "expected_observation": false,
          "matched_by": false
        },
        "required": [
          "fields",
          "intent_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "Realized"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "record_type": {
            "const": "realized_record"
          },
          "intent_ref": false,
          "assembly": false,
          "provider_preference": false,
          "matched_by": false,
          "policies": false
        },
        "required": [
          "fields",
          "outputs",
          "requested_ref",
          "provider"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "Discovered"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "record_type": {
            "const": "discovered_record"
          },
          "intent_ref": false,
          "requested_ref": false,
          "assembly": false,
          "provider_preference": false,
          "adopted_standards": false,
          "portability": false,
          "expected_observation": false,
          "process": false,
          "priced_by": false,
          "constituents": false,
          "dependencies": false,
          "sovereignty": false,
          "policies": false
        },
        "required": [
          "fields"
        ]
      }
    }
  ],
