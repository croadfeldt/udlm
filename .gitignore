# macOS noise
.DS_Store

# Generated by CI after the gate suite passes, and uploaded as a build artifact
# (.github/workflows/validate.yml). It stamps the commit it was built against, so every branch
# rewrote it and any two concurrent PRs conflicted on that line — which made GitHub's CONFLICTING
# flag useless as a signal for a real content clash. Nothing reads the committed copy: not a gate,
# not a tool, not a downstream repo. The artifact is the deliverable; an attestation is a claim
# about a CI run, and a copy in the tree can be stale or hand-edited, which an attestation must not.
model-validation-attestation.json
